{
  "name": "wareorb",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "demo": "bun scripts/demo.ts",
    "demo:reset": "bun scripts/demo.ts --reset",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:backend": "tsc -p convex --noEmit",
    "test": "bun test src/domain src/voice src/local && vitest run",
    "test:backend": "vitest run",
    "test:browser": "bun tests/browser/run.ts",
    "test:startup": "bun --no-env-file scripts/check-startup.ts",
    "check": "bun run test && bun run typecheck && bun run typecheck:backend && bun run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@clerk/react": "^6.18.1",
    "@convex-dev/rate-limiter": "^0.4.2",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@fontsource-variable/geist": "^5.2.5",
    "@fontsource-variable/geist-mono": "^5.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.3.0",
    "@shadcn/react": "^0.3.1",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "convex": "^1.48.0",
    "lucide-react": "^1",
    "radix-ui": "^1.8.1",
    "react": "^19",
    "react-dom": "^19",
    "sonner": "^2.0.8",
    "three": "^0.180.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.180.0",
    "convex-test": "^0.0.65",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5"
  },
  "module": "src/index.ts"
}
