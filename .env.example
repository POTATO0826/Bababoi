# WareOrb configuration template. Copy only what you need; real values never go into Git.

# ── Local presentation demo (`bun run demo`) ─────────────────────────────────
# Nothing here is required: `bun run demo` creates .env.local itself (mode 600, git-ignored) with an
# accountless local Convex deployment (CONVEX_DEPLOYMENT=anonymous:…, http://127.0.0.1 URLs) plus a
# generated presenter key pair and agent bridge secret. Do not copy cloud values into a demo checkout:
# the demo refuses CONVEX_DEPLOY_KEY, CONVEX_DEPLOYMENT_TOKEN, CONVEX_SELF_HOSTED_* and any
# non-anonymous CONVEX_DEPLOYMENT or non-127.0.0.1 CONVEX_URL in .env.local or .env.
# Optional settings, exported in your shell before `bun run demo`:
# WAREORB_DEMO_PORT=3000            # web page and local agent service (http://127.0.0.1:3000)
# WAREORB_CONVEX_PORT=3210          # local Convex backend API
# WAREORB_CONVEX_SITE_PORT=3211     # local Convex HTTP actions (default: WAREORB_CONVEX_PORT + 1)
# WAREORB_CONVEX_NODE=/path/to/node # Node.js 20, 22 or 24 for the local backend, if not found automatically
# WAREORB_AGENT_MODEL=openai-codex/gpt-6.1-sol   # or anthropic/claude-sonnet-5-5; default: first logged-in of these
# The agent's provider login is a one-time operator step outside the app: run `pi`, then `/login`.
# (An Anthropic API key exported as ANTHROPIC_API_KEY in the demo's shell also works; never put it in a file here.)

# ── Hosted deployment (Clerk + Convex cloud) ─────────────────────────────────
# Public browser settings for an isolated development deployment.
# Production values belong in the hosting platform's environment settings.
BUN_PUBLIC_CONVEX_URL=
BUN_PUBLIC_CONVEX_SITE_URL=
BUN_PUBLIC_CLERK_PUBLISHABLE_KEY=

# CLI target for cloud development only. Do not point test work at a shared database.
CONVEX_DEPLOYMENT=

# Backend environment (set in Convex dashboard, not the browser build):
# CLERK_JWT_ISSUER_DOMAIN=
# CLERK_SECRET_KEY=
# ANTHROPIC_API_KEY=
# LALAMOVE_API_KEY=
# LALAMOVE_API_SECRET=
# LALAMOVE_BASE_URL=https://rest.sandbox.lalamove.com
# FISH_API_KEY=
# FISH_VOICE_ID=

# Production hosting build only; never prefix secrets with BUN_PUBLIC_.
# Release builds refuse BUN_PUBLIC_WAREORB_LOCAL_DEMO / WAREORB_LOCAL_DEMO.
# CONVEX_DEPLOY_KEY=
