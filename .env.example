# Public browser settings. Copy to .env.local for an isolated development deployment.
# Production values belong in the hosting platform's environment settings.
BUN_PUBLIC_CONVEX_URL=
BUN_PUBLIC_CONVEX_SITE_URL=
BUN_PUBLIC_CLERK_PUBLISHABLE_KEY=

# CLI target for local development only. Do not point test work at a shared database.
CONVEX_DEPLOYMENT=

# Backend environment (set in Convex dashboard, not the browser build):
# CLERK_JWT_ISSUER_DOMAIN=
# CLERK_SECRET_KEY=
# ANTHROPIC_API_KEY=
# LALAMOVE_API_KEY=
# LALAMOVE_API_SECRET=
# LALAMOVE_BASE_URL=https://rest.sandbox.lalamove.com
# FISH_API_KEY=
# FISH_VOICE_ID=

# Production hosting build only; never prefix secrets with BUN_PUBLIC_.
# CONVEX_DEPLOY_KEY=
